        <mxCell id="41" value="Why Shift Rows LEFT?&lt;br&gt;&lt;br&gt;Bytes from one column get pushed into ALL 4 columns.&lt;br&gt;This mixes data across columns before MixColumns!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#D0D5DD;strokeWidth=2;fontColor=#1E2226;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="905" y="110" width="240" height="216" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Easy Rule to Remember: Row i cyclically shifts LEFT by i bytes (0, 1, 2, 3) — wrapping out the left &amp; into the right!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=2;fontColor=#1E8E3E;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

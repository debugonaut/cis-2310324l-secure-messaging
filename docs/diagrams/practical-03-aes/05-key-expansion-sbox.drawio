        <mxCell id="62" value="How S-Box Lookup Works (100% Simple):&lt;br&gt;&lt;br&gt;• 5F  ➔  Row 5, Column F  =  CF&lt;br&gt;• 31  ➔  Row 3, Column 1  =  C7&lt;br&gt;• 36  ➔  Row 3, Column 6  =  05&lt;br&gt;• 59  ➔  Row 5, Column 9  =  CB&lt;br&gt;&lt;br&gt;Every possible byte (00..FF) has one fixed partner." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E2226;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">

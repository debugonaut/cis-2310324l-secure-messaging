        <mxCell id="11" value="" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="18" width="530" height="482" as="geometry" />
        </mxCell>
        <mxCell id="12" value="HOW OUR CHAT APP USES AES-256-CBC" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#047857;strokeColor=#047857;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="18" width="530" height="46" as="geometry" />
        </mxCell>
        <mxCell id="13" value="1. Shared Passphrase → Key (PBKDF2)&#10;Derives strong 256-bit Encryption Key (K_enc) locally." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="88" width="465" height="70" as="geometry" />
        </mxCell>
        <mxCell id="14" value="2. Pad Message to 16-Byte Blocks&#10;PKCS#7 adds filler bytes so any length fits cleanly." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="182" width="465" height="70" as="geometry" />
        </mxCell>
        <mxCell id="15" value="3. Fresh Random IV + AES-256 (14 Rounds)&#10;CBC chains blocks so sending 'Hi' twice looks totally different!" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="276" width="465" height="78" as="geometry" />
        </mxCell>
        <mxCell id="16" value="4. Bob Decrypts in Reverse&#10;Only someone with the passphrase gets readable text (Confidentiality)." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#2F3437;strokeColor=#2F3437;strokeWidth=2;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="380" width="465" height="78" as="geometry" />
        </mxCell>

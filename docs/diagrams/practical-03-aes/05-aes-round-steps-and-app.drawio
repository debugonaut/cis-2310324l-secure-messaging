  <diagram id="05_Round_Steps_and_App_Integration" name="05 Round Steps and App Integration">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="520" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#F4F6F8;strokeColor=#2F3437;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="535" height="482" as="geometry" />
        </mxCell>
        <mxCell id="3" value="INSIDE EACH AES ROUND (4 SIMPLE STEPS)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#2F3437;strokeColor=#2F3437;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="535" height="46" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1. SUBSTITUTE BYTES (SubBytes)&#10;Replace each cell using a fixed lookup table (S-Box) to hide patterns." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="68" y="86" width="480" height="74" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2. SHIFT ROWS&#10;Simple Left Circular Shift (LCS) on rows 1, 2, 3 so bytes move columns." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="68" y="184" width="480" height="74" as="geometry" />
        </mxCell>
        <mxCell id="6" value="3. MIX COLUMNS   (Skipped in Final Round!)&#10;Blends all 4 bytes inside each column together for strong mixing." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FDF2F8;strokeColor=#C0267D;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="68" y="282" width="480" height="74" as="geometry" />
        </mxCell>
        <mxCell id="7" value="4. ADD ROUND KEY&#10;Simple bitwise XOR (⊕) combining the State grid with this round's Key." style="whiteSpace=wrap;html=1;rounded=1;fillColor=#FFFFFF;strokeColor=#2F3437;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="68" y="380" width="480" height="74" as="geometry" />
        </mxCell>
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F3437;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="308" y="160" as="sourcePoint" />
            <mxPoint x="308" y="184" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F3437;strokeWidth=2;endArrow=classic;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">

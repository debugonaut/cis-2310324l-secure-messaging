        <mxCell id="78" value="PKCS#7 Padding fills the gap&lt;br&gt;so AES always gets 16 bytes!&lt;br&gt;&lt;br&gt;Example: &quot;HELLO_BOB&quot; (9 B)&lt;br&gt;Adds 7 bytes of value 0x07:&lt;br&gt;&lt;br&gt;[9 text bytes] + [07×7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E2226;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1">

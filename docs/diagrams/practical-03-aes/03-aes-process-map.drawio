        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A73E8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="295" y="324" as="sourcePoint" />
            <mxPoint x="295" y="344" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="10" value="4. Repeat for K1..K14&lt;br&gt;Build all round subkeys before rounds start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="344" width="430" height="62" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#36393C;strokeWidth=2;fontColor=#1F2326;fontSize=15;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="30" width="500" height="410" as="geometry" />
        </mxCell>
        <mxCell id="12" value="PART B · DATA ROUNDS (Initial → Main → Final)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#36393C;strokeColor=#36393C;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="30" width="500" height="48" as="geometry" />
        </mxCell>
        <mxCell id="13" value="1. INITIAL ROUND&lt;br&gt;AddRoundKey (XOR Plaintext with Key 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#36393C;strokeWidth=2;fontColor=#1F2326;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="14" value="2. MAIN ROUNDS  (Repeat 9 / 11 / 13 times)&lt;br&gt;• SubBytes      • ShiftRows&lt;br&gt;• MixColumns    • AddRoundKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D8;strokeColor=#D97706;strokeWidth=2;fontColor=#1F2326;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="196" width="440" height="128" as="geometry" />
        </mxCell>
        <mxCell id="15" value="3. FINAL ROUND  (No MixColumns!)&lt;br&gt;SubBytes → ShiftRows → AddRoundKey → Ciphertext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=2;fontColor=#1F2326;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

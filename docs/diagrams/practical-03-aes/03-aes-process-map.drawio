        <mxCell id="3" value="PART A · KEY EXPANSION (Once per key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A73E8;strokeColor=#1A73E8;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="490" height="48" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1. RotWord&lt;br&gt;Take last column &amp; rotate top byte to bottom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="98" width="430" height="62" as="geometry" />
        </mxCell>
        <mxCell id="5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A73E8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="295" y="160" as="sourcePoint" />
            <mxPoint x="295" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6" value="2. SubBytes (S-Box)&lt;br&gt;Swap each byte using fixed 16×16 lookup table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="430" height="62" as="geometry" />
        </mxCell>
        <mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A73E8;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="295" y="242" as="sourcePoint" />
            <mxPoint x="295" y="262" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="8" value="3. XOR w/ Col 0 &amp; RCON&lt;br&gt;Mix with first column + Round Constant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="262" width="430" height="62" as="geometry" />

        <mxCell id="6" value="CASE 1: Length &lt; 64 Bytes&lt;br&gt;(Example: 16B or 32B K_mac)&lt;br&gt;&lt;br&gt;Append 0x00 zero bytes on the right&lt;br&gt;until total length reaches 64 bytes!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

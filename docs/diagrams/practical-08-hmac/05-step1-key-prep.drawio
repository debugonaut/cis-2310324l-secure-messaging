        <mxCell id="9" value="CASE 2: Length == 64 Bytes&lt;br&gt;(Exactly 512 Bits)&lt;br&gt;&lt;br&gt;Already matches SHA-256 block size.&lt;br&gt;Keep K directly as K₀!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

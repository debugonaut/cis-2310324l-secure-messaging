        <mxCell id="12" value="CASE 3: Length &gt; 64 Bytes&lt;br&gt;(Very long password/key)&lt;br&gt;&lt;br&gt;Hash K with SHA-256 down to 32 bytes,&lt;br&gt;then append 32 zero bytes ➔ 64 bytes!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D8;strokeColor=#D97706;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

        <mxCell id="4" value="BOB'S SEQUENCE LEDGER (Per-Sender Accepted List)&lt;br&gt;Previously Opened From Alice:  [ #001 ✔ ]   [ #002 ✔ ]&lt;br&gt;Check: Is incoming #seq already inside this list?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#36393C;strokeColor=#36393C;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

        <mxCell id="7" value="✖ REPLAY DETECTED (Blocked!)&lt;br&gt;#001 was already accepted earlier.&lt;br&gt;Decryption blocked &amp; marked &quot;Replay detected&quot;.&lt;br&gt;(Attacker can't fake #003 — breaks HMAC!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C53929;strokeWidth=2;fontColor=#C53929;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

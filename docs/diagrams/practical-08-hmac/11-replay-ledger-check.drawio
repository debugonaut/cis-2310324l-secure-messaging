  <diagram name="11 Anti-Replay Protection: Sequence Ledger Gate" id="diag-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="500" background="#FFFFFF">
      <root>

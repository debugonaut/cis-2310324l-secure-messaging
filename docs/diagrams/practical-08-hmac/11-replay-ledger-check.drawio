        <mxCell id="1" parent="0" />
        <mxCell id="2" value="THE REPLAY TRICK: If an attacker saves an old UNMODIFIED packet (#001) and re-sends it later,&lt;br&gt;its HMAC Tag STILL MATCHES (100% valid)!  ➔  So Bob needs a Sequence Ledger AFTER HMAC passes!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D8;strokeColor=#D97706;strokeWidth=2;fontColor=#1E2226;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">

<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="CIS-Diagram-Builder" version="24.0.0">
  <diagram name="03 Inside SHA-256 Compression Engine" id="diag-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="460" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="HOW THE UNDERLYING SHA-256 ENGINE PROCESSES ANY DATA BLOCK:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2326;fontSize=15;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3" value="1. INPUT BYTES&lt;br&gt;&lt;br&gt;Any length of text&lt;br&gt;or key + message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#36393C;strokeWidth=2;fontColor=#1E2226;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="82" width="235" height="155" as="geometry" />
        </mxCell>
        <mxCell id="4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#36393C;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="159" as="sourcePoint" />
            <mxPoint x="337" y="159" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5" value="2. PAD TO 512-BIT&lt;br&gt;&lt;br&gt;Split into exact&lt;br&gt;64-byte (512b) chunks&lt;br&gt;(1-bit + 0s + length)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontColor=#1E2226;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="337" y="82" width="235" height="155" as="geometry" />
        </mxCell>
        <mxCell id="6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#36393C;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="572" y="159" as="sourcePoint" />
            <mxPoint x="619" y="159" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7" value="3. 64 ROUNDS&lt;br&gt;&lt;br&gt;Mixes each chunk with&lt;br&gt;8 state variables (H0..H7)&lt;br&gt;using bitwise shifts/XOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D8;strokeColor=#D97706;strokeWidth=2;fontColor=#1E2226;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="619" y="82" width="235" height="155" as="geometry" />
        </mxCell>
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#36393C;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="854" y="159" as="sourcePoint" />
            <mxPoint x="901" y="159" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9" value="4. 256-BIT DIGEST&lt;br&gt;&lt;br&gt;Fixed 32-Byte Hash&lt;br&gt;(64 Hex Characters)&lt;br&gt;One-way &amp; collision-safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#36393C;strokeColor=#36393C;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="901" y="82" width="235" height="155" as="geometry" />
        </mxCell>
        <mxCell id="10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=2;fontColor=#1F2326;fontSize=15;fontStyle=0;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="278" width="1080" height="150" as="geometry" />
        </mxCell>
        <mxCell id="11" value="AVALANCHE EFFECT (WHY EVEN A 1-BIT TAMPER ALWAYS GETS CAUGHT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E8E3E;fontSize=14;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="290" width="1040" height="28" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Input A: &quot;HELLO_BOB&quot;&lt;br&gt;SHA256:  3196A4F2...810E4B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E3E;strokeWidth=2;fontColor=#1F2326;fontSize=13;fontStyle=1;fontFamily=Menlo;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="330" width="470" height="74" as="geometry" />
        </mxCell>
        <mxCell id="13" value="vs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2326;fontSize=16;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="344" width="50" height="40" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Input B: &quot;HELLO_BOC&quot;  (1 character changed!)&lt;br&gt;SHA256:  C920E81B...471D9A  (~50% bits flipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C53929;strokeWidth=2;fontColor=#C53929;fontSize=13;fontStyle=1;fontFamily=Menlo;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
